# DeepResearchAgent local configuration example.
# Copy this file to .env for local experiments. Do not commit real API keys.

# Web report workbench.
# The port is read when the process starts. Set it in the shell before running
# run_workbench.ps1; loading this file during a request cannot change the listener.
DEEP_RESEARCH_WEB_PORT=18181
DEEP_RESEARCH_WEB_HOST=127.0.0.1
# Required whenever DEEP_RESEARCH_WEB_HOST is not a loopback address.
DEEP_RESEARCH_ACCESS_TOKEN=
DEEP_RESEARCH_MAX_CONCURRENT_RUNS=2
DEEP_RESEARCH_TASK_TIMEOUT_SECONDS=300

# Deterministic demo mode is the default. It exercises collaboration but does
# not produce verified public citations.
DEEP_RESEARCH_USE_LLM=0
DEEP_RESEARCH_USE_WEB_SEARCH=0
DEEP_RESEARCH_ENABLE_REAL_SEARCH=0
# The following execution flags are used by the CLI. The browser workbench uses
# the collaboration DAG and enables at least two Red/Blue review rounds itself.
DEEP_RESEARCH_USE_ASYNC_DAG=0
DEEP_RESEARCH_USE_RED_BLUE_LOOP=0
DEEP_RESEARCH_SAVE_RUN=0

# Optional OpenAI-compatible LLM mode
DEEP_RESEARCH_LLM_PROVIDER=openai_compatible
DEEP_RESEARCH_LLM_MODEL=
DEEP_RESEARCH_LLM_API_KEY=
DEEP_RESEARCH_LLM_BASE_URL=https://api.openai.com/v1
# Use chat_completions for /chat/completions, or responses for /responses relays.
DEEP_RESEARCH_LLM_WIRE_API=chat_completions
DEEP_RESEARCH_LLM_USER_AGENT=OpenAI/Python 1.0.0
DEEP_RESEARCH_LLM_REASONING_EFFORT=
DEEP_RESEARCH_LLM_DISABLE_RESPONSE_STORAGE=false
DEEP_RESEARCH_LLM_MAX_OUTPUT_TOKENS=1800
DEEP_RESEARCH_LLM_TIMEOUT_SECONDS=60

# Optional web search / fetch mode for the CLI path. The collaboration
# workbench branch does not claim this as a production evidence source.
DEEP_RESEARCH_SEARCH_PROVIDER=duckduckgo_html
DEEP_RESEARCH_SEARCH_PROVIDER_ORDER=duckduckgo_html
DEEP_RESEARCH_SEARCH_MAX_RESULTS=5
DEEP_RESEARCH_SEARCH_TIMEOUT_SECONDS=15
DEEP_RESEARCH_FETCH_MAX_BYTES=2097152
DEEP_RESEARCH_USER_AGENT=DeepResearchAgent/0.1

# Optional provider API keys
DEEP_RESEARCH_BRAVE_API_KEY=
DEEP_RESEARCH_SERPAPI_API_KEY=
DEEP_RESEARCH_TAVILY_API_KEY=

# Optional async DAG settings
DEEP_RESEARCH_DAG_MAX_CONCURRENCY=3
DEEP_RESEARCH_DAG_TASK_TIMEOUT_SECONDS=30

# Optional CLI Red/Blue loop settings. The browser workbench currently uses two
# visible rounds by default and caps its request at three rounds.
DEEP_RESEARCH_RED_BLUE_MAX_ROUNDS=3
DEEP_RESEARCH_RED_BLUE_NO_IMPROVEMENT_ROUNDS=2
DEEP_RESEARCH_RED_BLUE_OSCILLATION_DETECTION=true

# Optional persisted run store
DEEP_RESEARCH_RUN_STORE_PATH=runs/deep_research_runs.sqlite3
