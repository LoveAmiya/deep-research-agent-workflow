# DeepResearchAgent local configuration example.
# Copy this file to .env for local experiments. Do not commit real API keys.

# Web report workbench
DEEP_RESEARCH_WEB_PORT=18181

# Deterministic mode is the default.
DEEP_RESEARCH_USE_LLM=0
DEEP_RESEARCH_USE_WEB_SEARCH=0
DEEP_RESEARCH_ENABLE_REAL_SEARCH=0
DEEP_RESEARCH_USE_ASYNC_DAG=0
DEEP_RESEARCH_USE_RED_BLUE_LOOP=0
DEEP_RESEARCH_SAVE_RUN=0

# Optional OpenAI-compatible LLM mode
DEEP_RESEARCH_LLM_PROVIDER=openai_compatible
DEEP_RESEARCH_LLM_MODEL=
DEEP_RESEARCH_LLM_API_KEY=
DEEP_RESEARCH_LLM_BASE_URL=https://api.openai.com/v1
DEEP_RESEARCH_LLM_TIMEOUT_SECONDS=60

# Optional web search / fetch mode
DEEP_RESEARCH_SEARCH_PROVIDER=duckduckgo_html
DEEP_RESEARCH_SEARCH_PROVIDER_ORDER=duckduckgo_html,mock
DEEP_RESEARCH_SEARCH_MAX_RESULTS=5
DEEP_RESEARCH_SEARCH_TIMEOUT_SECONDS=15
DEEP_RESEARCH_USER_AGENT=DeepResearchAgent/0.1

# Optional provider API keys
DEEP_RESEARCH_BRAVE_API_KEY=
DEEP_RESEARCH_SERPAPI_API_KEY=
DEEP_RESEARCH_TAVILY_API_KEY=

# Optional async DAG settings
DEEP_RESEARCH_DAG_MAX_CONCURRENCY=3
DEEP_RESEARCH_DAG_TASK_TIMEOUT_SECONDS=30

# Optional Red/Blue loop settings
DEEP_RESEARCH_RED_BLUE_MAX_ROUNDS=3
DEEP_RESEARCH_RED_BLUE_NO_IMPROVEMENT_ROUNDS=2
DEEP_RESEARCH_RED_BLUE_OSCILLATION_DETECTION=true

# Optional persisted run store
DEEP_RESEARCH_RUN_STORE_PATH=runs/deep_research_runs.sqlite3
